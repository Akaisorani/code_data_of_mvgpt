flag is True, and result is player\_id, height
FROM Player
WHERE height = (SELECT MAX(height) FROM Player)
```
-- Output:
-- player_id | height
--        1 | 190
--        3 | 190
--        4 | 188
--        5 | 187
--        6 | 190
--        7 | 185
--        8 | 185
--        9 | 188
--       10 | 190
--       11 | 187
--       12 | 185
```
-- Which team has the most number of players with height 187 cm?
```
SELECT
  team_id,
  COUNT(height = 187) AS num_players
FROM Player
GROUP BY team_id
ORDER BY num_players DESC
LIMIT 1;
```
-- Output:
-- team\_id | num\_players
