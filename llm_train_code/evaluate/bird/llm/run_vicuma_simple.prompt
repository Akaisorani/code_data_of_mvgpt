```vbnet
SELECT r.name AS race_name, c.name AS circuit_name
FROM races r
JOIN circuits c ON r.circuitId = c.circuitId
WHERE r.url = 'http://www.formula1.com/en/races/previous/2022/GBR/Silverstone.html';
```
