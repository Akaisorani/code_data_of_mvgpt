flag is True, and result is postHistory.Id, postHistory.RevisionGUID, postHistory.Text, postHistory.CreationDate
FROM postHistory
JOIN posts ON postHistory.PostId = posts.Id
JOIN comments ON postHistory.Id = comments.Id
WHERE postHistory.RevisionGUID IS NOT NULL
AND postHistory.Comment > 0
AND postHistory.Comment = 1
AND comments.Score = 0
ORDER BY postHistory.CreationDate DESC;
