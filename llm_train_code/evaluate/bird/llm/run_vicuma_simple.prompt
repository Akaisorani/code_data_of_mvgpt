```sql
SELECT drivers.driverId, drivers.surname, drivers.forename, drivers.dob, drivers.nationality
FROM drivers
JOIN constructors ON drivers.constructorRef = constructors.constructorRef
JOIN seasons ON drivers.year = seasons.year
WHERE drivers.nationality = 'Japanese' AND drivers.year = (SELECT MIN(year(dob)) FROM drivers WHERE nationality = 'Japanese');
```
