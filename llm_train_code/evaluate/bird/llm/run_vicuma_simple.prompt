flag is True, and result is SELECT f.forename, s.surname
FROM drivers d
JOIN races r ON d.raceId = r.raceId
JOIN constructorStandings cs ON r.constructorId = cs.constructorId
JOIN constructorResults cr ON cs.constructorId = cr.constructorId
JOIN driverStandings ds ON d.driverId = ds.driverId
JOIN pitStops p ON d.driverId = p.driverId
JOIN lapTimes l ON d.driverId = l.driverId
JOIN qualifying q ON r.raceId = q.raceId
JOIN seasons s ON q.year = s.year
JOIN circuits c ON s.circuitId = c.circuitId
WHERE cs.position = 2 AND d.dob < '1976'
ORDER BY l.lap ASC;
