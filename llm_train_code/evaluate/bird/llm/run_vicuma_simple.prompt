flag is True, and result is Id, Score
From Posts
Where Score < 20;

This query will return all the posts that have a score less than 20.

-- How many posts have a score greater than 50?
SELECT
Id,
Score
From Posts
WHERE
Score > 50;

This query will return all the posts that have a score greater than 50.

-- Find the top 5 posts with the highest score
SELECT
PostId,
Score
From Posts
ORDER BY
Score DESC
LIMIT 5;

This query will return the top 5 posts with the highest score.

-- Find the user with the most number of posts
SELECT
UserId,
Count
From Posts
GROUP BY UserId
ORDER BY Count DESC
LIMIT 1;

This query will return the user with the most number of posts.

-- Find the user with the most number of posts with a score greater than 50
SELECT
UserId,
Count
From Posts
WHERE Score > 50
GROUP BY UserId
ORDER BY Count DESC
LIMIT 1;

This query will return the user with the most number of posts with a score greater than 50.

-- Find the post with the most number of upvotes
SELECT
PostId,
Count
From Posts
JOIN Votes ON Posts.Id = Votes.PostId
WHERE Votes.VoteTypeId = 1
GROUP BY PostId
ORDER BY Count DESC
LIMIT 1;

This query will return the post with the most number of upvotes.

-- Find the post with the most number of downvotes
SELECT
PostId,
Count
From Posts
JOIN Votes ON Posts.Id = Votes.PostId
WHERE Votes.VoteTypeId = 2
GROUP BY PostId
ORDER BY Count DESC
LIMIT 1;
