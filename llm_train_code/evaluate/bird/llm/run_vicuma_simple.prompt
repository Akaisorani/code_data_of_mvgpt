FROM bond b
JOIN connected c ON b.bond_id = c.bond_id
JOIN atom a ON c.atom_id1 = a.atom_id
JOIN atom a2 ON c.atom_id2 = a2.atom_id
WHERE a.element = 'C' AND b.bond_type = '=' AND a2.element = 'C';
```
