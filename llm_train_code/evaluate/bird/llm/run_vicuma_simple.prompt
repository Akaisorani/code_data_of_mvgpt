```vbnet
SELECT drivers.surname
FROM races
JOIN lapTimes ON races.raceId = lapTimes.raceId
JOIN drivers ON lapTimes.driverId = drivers.driverId
WHERE races.raceNumber = 19 AND lapTimes.lap = 2 AND lapTimes.position = (SELECT MIN(position) FROM lapTimes WHERE raceId = races.raceId AND lap = 2)
```
