SELECT SUM(loan.amount)
FROM client
JOIN disp ON client.district_id = disp.district_id
JOIN loan ON disp.account_id = loan.account_id
WHERE loan.status = 'active' AND loan.bank_to = 'Litomerice' AND YEAR(loan.date) = 1996;
```
