  INTEGER,\n    source         TEXT,\n    notes          TEXT,\n    link_to_member TEXT\n        constraint income_member_member_id_fk\n            references member\n)\n\nCREATE TABLE "member"\n(\n    member_id     TEXT\n        constraint member_pk\n            primary key,\n    first_name    TEXT,\n    last_name     TEXT,\n    email         TEXT,\n    position      TEXT,\n    t_shirt_size  TEXT,\n    phone         TEXT,\n    zip           INTEGER\n        constraint member_zip_code_zip_code_fk\n            references zip_code,\n    link_to_major TEXT\n        references major\n)\n\n-- External Knowledge: event refers to event_name where MIN(cost)\n-- Using valid SQLite and understading External Knowledge, answer the following questions for the tables provided above.\n-- Which event has the lowest cost?\nGenerate the SQL after thinking step by step: \nSELECT '}]}
flag is True, and result is event.event\_id
FROM event
JOIN expense ON expense.link\_to\_event = event.event\_id
JOIN budget ON expense.link\_to\_budget = budget.budget\_id
WHERE cost = (SELECT MIN(cost) FROM expense)
```
--or

SELECT event.event_id
FROM event
JOIN expense ON expense.link_to_event = event.event_id
JOIN budget ON expense.link_to_budget = budget.budget_id
JOIN member ON expense.link_to_member = member.member_id
JOIN "attendance" ON expense.link_to_event = attendance.link_to_event
JOIN "zip_code" ON attendance.zip_code = "zip_code"."zip_code"
WHERE cost = (SELECT MIN(cost) FROM expense)
```
-- Which event has the highest cost?

```
SELECT event.event_id
FROM event
JOIN expense ON expense.link_to_event = event.event_id
JOIN budget ON expense.link_to_budget = budget.budget_id
WHERE cost = (SELECT MAX(cost) FROM expense)
```
-- Which member has the highest cost?
```
SELECT member.member_id
FROM member
JOIN expense ON expense.link_to_member = member.member_id
JOIN income ON expense.link_to_member = income.link_to_member
WHERE cost = (SELECT MAX(cost) FROM expense)
```
