    ((SELECT Count(FRPMCount) FROM frpm WHERE IRC = 1 AND EducationalOptionType = 'Y' AND Charter = 0) / (SELECT Count(CDSCode) FROM frpm WHERE IRC = 1 AND EducationalOptionType = 'Y' AND Charter = 0)) * 100 AS `Percent (%) Eligible FRPM (K-12)`
