```
SELECT 
  A.percentage 
FROM 
  (SELECT 
    A.bond_id, 
    A.bond_type, 
    (100 * COUNT(bond_type = '-') / COUNT(*)) AS percentage
  FROM 
    `bond` A
  WHERE 
    A.bond_type = '-'
  GROUP BY 
    A.bond_id) AS A
```
