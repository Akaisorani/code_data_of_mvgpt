```vbnet
SELECT p.player_name, p.country, p.player_id, p.club, p.market_value, pl.home_goals, pl.away_goals, pl.home_win, pl.away_win
FROM Match m
JOIN Player p ON m.home_team_api_id = p.player_api_id
JOIN League l ON m.league_id = l.id
JOIN Team t ON m.home_team_api_id = t.team_api_id
JOIN Player pl ON m.away_team_api_id = pl.player_api_id
WHERE p.preferred_foot = 'left';
```
