-- Which driver has won the most races in the 2010s?
SELECT driver.driver\_id
FROM races
JOIN drivers ON races.driver\_id = drivers.driver\_id
JOIN constructorStandings ON races.race\_id = constructorStandings.race\_id
WHERE YEAR(races.year) >= 2010 AND races.race\_id = (SELECT race\_id FROM races WHERE YEAR(race\_year) >= 2010 GROUP BY race\_id ORDER BY COUNT(*) DESC LIMIT 1);

