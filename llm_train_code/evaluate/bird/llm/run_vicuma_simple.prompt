flag is True, and result is related\_posts.Title, link\_type.Id
FROM related\_posts
JOIN postHistory ON related\_posts.Id = postHistory.PostId
JOIN link\_type ON postHistory.LinkTypeId = link\_type.Id
WHERE related\_posts.Title = 'What are principal component scores?';
