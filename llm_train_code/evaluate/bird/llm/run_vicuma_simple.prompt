the question is: List out the type of events which have remaining budget more than 30 USD.
models request {'model': 'vicuna-13b-1.1', 'messages': [{'role': 'user', 'content': 'CREATE TABLE event\n(\n    event_id   TEXT\n        constraint event_pk\n            primary key,\n    event_name TEXT,\n    event_date TEXT,\n    type       TEXT,\n    notes      TEXT,\n    location   TEXT,\n    status     TEXT\n)\n\nCREATE TABLE major\n(\n    major_id   TEXT\n        constraint major_pk\n            primary key,\n    major_name TEXT,\n    department TEXT,\n    college    TEXT\n)\n\nCREATE TABLE zip_code\n(\n    zip_code    INTEGER\n        constraint zip_code_pk\n            primary key,\n    type        TEXT,\n    city        TEXT,\n    county      TEXT,\n    state       TEXT,\n    short_state TEXT\n)\n\nCREATE TABLE "attendance"\n(\n    link_to_event  TEXT\n        constraint attendance_event_event_id_fk\n            references event,\n    link_to_member TEXT\n        constraint attendance_member_member_id_fk\n            references member,\n    constraint attendance_pk\n        primary key (link_to_event, link_to_member)\n)\n\nCREATE TABLE "budget"\n(\n    budget_id     TEXT\n        constraint budget_pk\n            primary key,\n    category      TEXT,\n    spent         FLOAT,\n    remaining     FLOAT,\n    amount        INTEGER,\n    event_status  TEXT,\n    link_to_event TEXT\n        constraint budget_event_event_id_fk\n            references event\n)\n\nCREATE TABLE "expense"\n(\n    expense_id          TEXT\n        constraint expense_pk\n            primary key,\n    expense_description TEXT,\n    expense_date        TEXT,\n    cost                REAL,\n    approved            TEXT,\n    link_to_member      TEXT\n        constraint expense_member_member_id_fk\n            references member,\n    link_to_budget      TEXT\n        constraint expense_budget_budget_id_fk\n            references budget\n)\n\nCREATE TABLE "income"\n(\n    income_id      TEXT\n        constraint income_pk\n            primary key,\n    date_received  TEXT,\n    amount         INTEGER,\n    source         TEXT,\n    notes          TEXT,\n    link_to_member TEXT\n        constraint income_member_member_id_fk\n            references member\n)\n\nCREATE TABLE "member"\n(\n    member_id     TEXT\n        constraint member_pk\n            primary key,\n    first_name    TEXT,\n    last_name     TEXT,\n    email         TEXT,\n    position      TEXT,\n    t_shirt_size  TEXT,\n    phone         TEXT,\n    zip           INTEGER\n        constraint member_zip_code_zip_code_fk\n            references zip_code,\n    link_to_major TEXT\n        references major\n)\n\n-- External Knowledge: remaining budget more than 30 USD refers to remaining > 30\n-- Using valid SQLite and understading External Knowledge, answer the following questions for the tables provided above.\n-- List out the type of events which have remaining budget more than 30 USD.\nGenerate the SQL after thinking step by step: \nSELECT '}]}
flag is True, and result is SELECT e.event\_name, e.event\_date, e.type, e.notes, e.location, e.status
FROM event e
JOIN attendance a ON e.event\_id = a.link\_to\_event
JOIN budget b ON a.link\_to\_event = b.link\_to\_event
JOIN expense e ON b.budget\_id = e.link\_to\_budget
WHERE e.event\_id IN (
SELECT event\_id
FROM event
JOIN major m ON event.event\_id = m.major\_id
JOIN zip\_code z ON event.event\_id = z.zip\_code
WHERE z.type = 'remaining'
AND b.category IN ('food', 'transportation', 'lodging')
)
ORDER BY e.event\_date;
