```sql
CREATE TABLE circuits (
   circuitId INTEGER PRIMARY KEY,
   name TEXT,
   location TEXT,
   country TEXT
);

CREATE TABLE locations (
   locationId INTEGER PRIMARY KEY,
   location TEXT,
   lat REAL,
   lng REAL
);

ALTER TABLE circuits
ADD FOREIGN KEY (location) REFERENCES locations (locationId);
```
