flag is True, and result is SELECT f.forename, s.surname, dob
FROM drivers d
JOIN constructors c ON d.constructorRef = c.constructorRef
JOIN seasons s ON c.season = s.season
JOIN races r ON c.race = r.race
JOIN driverStandings ds ON d.driverId = ds.driverId
WHERE ds.position = 1 AND s.year BETWEEN '1981' AND '1991' AND d.nationality = 'Asian'
ORDER BY dob;

