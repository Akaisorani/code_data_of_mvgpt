flag is True, and result is OwnerDisplayName
FROM posts
JOIN (
SELECT MAX(ViewCount) AS max\_view\_count, OwnerUserId
FROM posts
GROUP BY OwnerUserId
) max\_view\_count\_owner\_id
ON posts.OwnerUserId = max\_view\_count\_owner\_id.OwnerUserId
WHERE max\_view\_count\_owner\_id.max\_view\_count = (SELECT MAX(ViewCount) FROM posts);
